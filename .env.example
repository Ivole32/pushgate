# Copy to .env and replace the example values. This file contains placeholders only.
# Secrets are NOT configured here: they are files in ./secrets (see scripts/gen-secrets.sh).

# ---- Docker publishing ----
# pushgate is published on 127.0.0.1 only; your host reverse proxy forwards to this port.
# Must be in the allowed range 2000-2999.
PUSHGATE_PORT=2580
# Docker network (defaults shown; must stay inside the subnet reserved for this app).
# PUSHGATE_SUBNET=172.20.2.0/24
# PUSHGATE_GATEWAY=172.20.2.1      # also becomes TRUSTED_PROXIES (the only trusted forwarder)
# PUSHGATE_IP=172.20.2.10

# ---- Application ----
# The public HTTPS URL served by your host reverse proxy, exactly as opened on the phone.
# Passkeys are bound to this hostname. Example: https://notify.example.com
PUBLIC_ORIGIN=https://notify.example.com

# Who may open the web app (set up the phone, manage keys/devices). Choose exactly one:
#   ADMIN_PUBLIC=true   from any network (default). Login needs your passkey; the first passkey
#                       needs a one-time token from the server CLI. See README "How it is secured".
#   ADMIN_CIDRS=...     only from the listed networks (e.g. home LAN or VPN), comma separated.
ADMIN_PUBLIC=true
# ADMIN_CIDRS=192.168.1.0/24

# Addresses allowed to SEND notifications (POST /api/v1/notifications). Always required and
# never public: list where your sending services connect from, as narrowly as possible.
#   - another server:                         its public IP, e.g. 203.0.113.7/32
#   - a program on this server (not in Docker) using the public URL: this server's public IP /32
#   - a container on this server using the public URL: its Docker address, e.g. 172.18.0.5/32
#   - home network behind a router:           your home's public IP as /32
# Not sure? Send a test request; the refused address appears in the app under "Security events"
# (network.rejected, zone api) and in `docker compose logs pushgate`.
# EXAMPLE VALUE ONLY - replace. /0 is refused; an invalid value stops startup.
TRUSTED_CIDRS=203.0.113.7/32

# Contact for push services (Apple requires a valid mailto: or https: URL).
VAPID_SUBJECT=mailto:you@example.com

# Block sending until an administrator passkey has been enrolled (recommended: true).
REQUIRE_SETUP_BEFORE_SENDING=true
# Global kill switch for the sending API.
NOTIFICATIONS_ENABLED=true

# Optional tuning (defaults shown)
# RATE_LIMIT_PER_KEY_PER_MINUTE=30
# RATE_LIMIT_GLOBAL_PER_MINUTE=120
# RATE_LIMIT_PER_ACCOUNT_PER_MINUTE=120      # all keys of one account together
# AUTH_FAILURE_LIMIT=10
# AUTH_BLOCK_MINUTES=15
# RATE_LIMIT_ADMIN_ANONYMOUS_PER_MINUTE=30   # login/enrollment requests per client
# RATE_LIMIT_ADMIN_PER_ACCOUNT_PER_MINUTE=120 # signed-in web app requests per account
# RATE_LIMIT_PLUGIN_ANONYMOUS_PER_MINUTE=60  # plugin routes without a session, per client
# HISTORY_RETENTION_DAYS=7        # delivery metadata only; 0 = keep none
# AUDIT_RETENTION_DAYS=90
# SESSION_IDLE_MINUTES=30
# SESSION_MAX_HOURS=12
# MAX_DEVICES=20
# MAX_API_KEYS=100                # active keys per account (web app)
# MAX_PASSKEYS=20                 # passkeys per account
# PUSH_ENDPOINT_HOSTS=push.apple.com,fcm.googleapis.com,push.services.mozilla.com,notify.windows.com
# LOG_LEVEL=info
