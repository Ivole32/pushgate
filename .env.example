# Copy to .env and replace EVERY value. This file contains placeholders only.
# Secrets are NOT configured here: they are files in ./secrets (see scripts/gen-secrets.sh).

# ---- Reverse proxy (Caddy) ----
# Hostname the iPhone uses to reach the server. Must resolve to LISTEN_ADDRESS on your LAN.
PUSHGATE_HOSTNAME=notify.home.example
# The ONE host interface Caddy listens on (the server's LAN IP). Never 0.0.0.0 by accident.
LISTEN_ADDRESS=192.0.2.10
HTTPS_PORT=443

# ---- Application ----
# Must match PUSHGATE_HOSTNAME (and HTTPS_PORT if not 443). Passkeys are bound to this origin.
PUBLIC_ORIGIN=https://notify.home.example

# Networks allowed to SEND notifications (POST /api/v1/notifications).
# EXAMPLE VALUES ONLY — replace with your actual trusted networks. Keep them as narrow as possible
# (e.g. the server VLAN or single hosts like 192.168.1.20/32). /0 is refused. Invalid -> no start.
TRUSTED_CIDRS=192.168.1.0/24,10.0.0.0/24

# Networks allowed to open the web app / admin API (your phone's Wi-Fi or VPN range).
# EXAMPLE VALUES ONLY — replace.
ADMIN_CIDRS=192.168.1.0/24

# Contact for push services (Apple requires a valid mailto: or https: URL).
VAPID_SUBJECT=mailto:you@example.com

# Block sending until an administrator passkey has been enrolled (recommended: true).
REQUIRE_SETUP_BEFORE_SENDING=true
# Global kill switch for the sending API.
NOTIFICATIONS_ENABLED=true

# Optional tuning (defaults shown)
# RATE_LIMIT_PER_KEY_PER_MINUTE=30
# RATE_LIMIT_GLOBAL_PER_MINUTE=120
# AUTH_FAILURE_LIMIT=10
# AUTH_BLOCK_MINUTES=15
# HISTORY_RETENTION_DAYS=7        # delivery metadata only; 0 = keep none
# AUDIT_RETENTION_DAYS=90
# SESSION_IDLE_MINUTES=30
# SESSION_MAX_HOURS=12
# MAX_DEVICES=20
# PUSH_ENDPOINT_HOSTS=push.apple.com,fcm.googleapis.com,push.services.mozilla.com,notify.windows.com
# LOG_LEVEL=info
