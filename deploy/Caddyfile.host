# Site block for a Caddy instance running on the HOST (not in Docker), in front of pushgate
# published on 127.0.0.1:2580. Merge it into your existing Caddyfile.
#
# Do NOT configure `trusted_proxies` for this site: Caddy is the first hop, so client-supplied
# forwarding headers must never be trusted. Without it, {remote_host} is the TCP peer.

notify.home.example {
	# TLS: by default Caddy gets a Let's Encrypt certificate (the name must be reachable from the
	# internet on port 80/443). Alternatives:
	#   tls { dns <provider> ... }                      ACME DNS-01 (Caddy build with the DNS plugin),
	#                                                   for a server reachable only from the LAN
	#   tls /etc/ssl/pushgate/fullchain.pem /etc/ssl/pushgate/key.pem
	#   tls internal                                    Caddy's own CA. Its root must be trusted on the
	#                                                   iPhone, and a trusted root can vouch for ANY site:
	#                                                   whoever takes over this server could then read
	#                                                   the phone's TLS traffic. Avoid it if you can.

	# Optional: restrict who can reach this site at all (pushgate enforces its own CIDRs too).
	# @outside not remote_ip 192.168.1.0/24
	# respond @outside 403

	request_body {
		max_size 64KB
	}

	reverse_proxy 127.0.0.1:2580 {
		# Overwrite (not append) the forwarding header with the TCP peer address. pushgate accepts
		# exactly one address in this header, and only from the Docker network gateway.
		header_up X-Forwarded-For {remote_host}
		header_up -Forwarded
		header_up -X-Real-IP
	}
}
