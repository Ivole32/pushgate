# Caddy reverse proxy for pushgate.
#
# TLS options (pick ONE in the site block below):
#   1. tls internal                       Caddy's own CA (default). Install the root certificate on
#                                         the iPhone and enable full trust (README "HTTPS").
#   2. tls /certs/fullchain.pem /certs/key.pem
#                                         Certificates you obtain elsewhere (e.g. ACME DNS-01 on another
#                                         host). Mount them read-only into the container.
#   3. tls { dns <provider> ... }          ACME DNS-01 directly; needs a Caddy build with your DNS
#                                         provider plugin (xcaddy). Works without exposing anything.
# Do NOT configure `trusted_proxies` here: Caddy is the first hop, so client-supplied
# forwarding headers must never be trusted. Without it, {remote_host} is the TCP peer.
{
	admin off
}

{$PUSHGATE_HOSTNAME} {
	tls internal

	request_body {
		max_size 64KB
	}

	reverse_proxy 172.31.250.3:8080 {
		# Overwrite (not append) the forwarding header with the TCP peer address. pushgate accepts
		# exactly one address in this header and only from this proxy.
		header_up X-Forwarded-For {remote_host}
		header_up -Forwarded
		header_up -X-Real-IP
	}

	header -Server
}
