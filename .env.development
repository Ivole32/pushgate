# Local development only (npm run dev). Production settings live in .env (see .env.example).
PUBLIC_ORIGIN=http://localhost:8080
LISTEN_HOST=127.0.0.1
PORT=8080
DATA_DIR=.dev/data
API_KEY_PEPPER_FILE=.dev/secrets/api_key_pepper
VAPID_PRIVATE_KEY_FILE=.dev/secrets/vapid_private_key
VAPID_SUBJECT=mailto:admin@example.invalid
TRUSTED_CIDRS=127.0.0.1/32,::1/128
ADMIN_CIDRS=127.0.0.1/32,::1/128
